# Normalize line endings: LF in the repository for scripts that must run on
# any OS, CRLF for Windows batch files (cmd is picky about bare LF).
* text=auto

*.sh text eol=lf
*.gs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Keep generated/collected binary assets out of line-ending conversion.
# fixtures/text-300p.pdf is ASCII-only, so Git would otherwise treat it as
# text and rewrite every LF as CRLF on checkout, breaking its xref table.
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pfb binary
*.bcmap binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
